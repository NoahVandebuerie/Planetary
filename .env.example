PLANETARY_ENV=production

# Node app
PORT=3000
AUTH_BACKEND_URL=http://127.0.0.1:8000

# Auth backend
PLANETARY_DB_PATH=backend/data/planetary.db
PLANETARY_COOKIE_SECURE=true
PLANETARY_COOKIE_SAMESITE=lax

# SMTP for invite / transfer email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=noreply@example.com

# Development only
SMTP_USE_TEST_ACCOUNT=false
